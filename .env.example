# Copy to `.env.local` and adjust. Never commit real secrets.

# Set to 1 for deterministic fixtures (no Google key required): tailoring samples
# and JD matching (/api/jd/match). Set to 0 for real Gemini calls.
MOCK_AI=1

# Google Generative AI model ID (used when MOCK_AI is not set).
# Example: gemini-3.1-flash-lite
AI_MODEL=

# Required for live AI when MOCK_AI is unset. Get a key from Google AI Studio.
GOOGLE_GENERATIVE_AI_API_KEY=

# Required for live AI: shared limit of 10 attempts per IP per 24 hours.
# Create an Upstash Redis database and copy its REST URL and write token.
# Without these, live AI is blocked to protect your Google quota.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
