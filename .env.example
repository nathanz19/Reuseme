# Copy to `.env.local` and adjust. Never commit real secrets.

# Set to 1 for deterministic tailoring samples (no Google key required).
# Set to 0 for real Gemini tailoring. JD matching still uses local demo fixtures.
MOCK_AI=1

# Google Generative AI model ID (used when MOCK_AI is not set).
# Example: gemini-3.1-flash-lite
AI_MODEL=

# Required for live AI when MOCK_AI is unset. Get a key from Google AI Studio.
GOOGLE_GENERATIVE_AI_API_KEY=
